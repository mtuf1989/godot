#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_symphony = env_modules.Clone()

# Enable WebAssembly SIMD for auto-vectorization on web builds.
if env["platform"] == "web":
    env_symphony.Append(CCFLAGS=["-msimd128"])

# --- pffft (Pretty Fast FFT) thirdparty library ---
# BSD-like license. Used for spectral processing (PhaseVocoder, SpectralGate).
# SIMD auto-detects from compiler flags set by Godot's platform build.
env_pffft = env_modules.Clone()
env_pffft.Append(CPPPATH=["thirdparty/pffft"])
env_pffft.Append(CPPDEFINES=["PFFFT_STATIC_DEFINE"])

# Only build single-precision float (we don't need double)
env_pffft.Append(CPPDEFINES=["PFFFT_USE_TYPE_FLOAT"])

# Disable compiler warnings for thirdparty code
if env.msvc:
    env_pffft.Append(CCFLAGS=["/W0"])
else:
    env_pffft.Append(CCFLAGS=["-w"])

# Web SIMD support (NEON path via SIMDe)
if env["platform"] == "web":
    env_pffft.Append(CCFLAGS=["-msimd128"])

env_pffft.add_source_files(env.modules_sources, "thirdparty/pffft/pffft.c")
env_pffft.add_source_files(env.modules_sources, "thirdparty/pffft/pffft_common.c")
env_pffft.add_source_files(env.modules_sources, "thirdparty/pffft/fftpack.c")

# Make pffft headers available to symphony sources
env_symphony.Append(CPPPATH=["thirdparty/pffft"])
env_symphony.Append(CPPDEFINES=["PFFFT_STATIC_DEFINE"])

# --- Symphony module sources ---
env_symphony.add_source_files(env.modules_sources, "*.cpp")
env_symphony.add_source_files(env.modules_sources, "core/*.cpp")
env_symphony.add_source_files(env.modules_sources, "stream/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/generators/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/filters/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/envelopes/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/math/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/timing/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/io/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/delay/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/utility/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/synthesis/*.cpp")
env_symphony.add_source_files(env.modules_sources, "nodes/spectral/*.cpp")
env_symphony.add_source_files(env.modules_sources, "runtime/*.cpp")
env_symphony.add_source_files(env.modules_sources, "spatial/*.cpp")

if env.editor_build:
    env_symphony.add_source_files(env.modules_sources, "editor/*.cpp")
