#!/usr/bin/env python
Import("env")
Import("env_modules")
import json
import subprocess

def git(*args):
    return subprocess.check_output(["git", *args], text=True).strip()

identity = {
    "commit": git("rev-parse", "HEAD"),
    "dirty": bool(git("status", "--porcelain", "--untracked-files=normal")),
    "platform": env["platform"],
    "architecture": env["arch"],
    "target": env["target"],
    "modules": sorted(env.module_list),
    "options": {k: env[k] for k in ["tests", "dev_build", "precision", "optimize", "disable_3d", "threads"]},
}

def build_identity(target, source, env):
    text = json.dumps(identity, sort_keys=True, separators=(",", ":"))
    with open(str(target[0]), "w") as output:
        output.write("// Generated build identity.\n#define AGENT_BUILD_IDENTITY " + json.dumps(text) + "\n")

header = env.CommandNoCache("build_identity.gen.h", env.Value(identity), build_identity)
env_agent = env_modules.Clone()
sources = []
env_agent.add_source_files(sources, "*.cpp")
env.Depends(sources, header)
env.modules_sources += sources
